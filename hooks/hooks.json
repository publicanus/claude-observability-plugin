{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/run_hook.sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/langfuse_hook.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/run_hook.sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/langfuse_hook.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/run_hook.sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/langfuse_hook.py"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^(langfuse-observability:)?langfuse-setup$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/run_hook.sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/langfuse_hook.py"
          }
        ]
      }
    ]
  }
}
